---
import NidoMark from './NidoMark.astro';

const SUPPORT_EMAIL = 'soporte@nidu.app';

const producto = [
	{ href: '/#producto', label: 'Producto' },
	{ href: '/#como', label: 'Cómo funciona' },
	{ href: '/#para-quien', label: 'Para quién' },
	{ href: '/#pases', label: 'Tipos de pase' },
	{ href: '/#precios', label: 'Precios' },
	{ href: '/#ia', label: 'IA' },
	{ href: '/#faq', label: 'FAQ' },
];

const pases = [
	{ href: '/#pases', label: 'Fidelización' },
	{ href: '/#pases', label: 'Cupón' },
	{ href: '/#pases', label: 'Entrada' },
	{ href: '/#pases', label: 'Membresía' },
	{ href: '/#pases', label: 'Tarjeta de regalo' },
	{ href: '/#pases', label: 'Pase' },
	{ href: '/#pases', label: 'Niveles' },
];

const legal = [
	{ href: '/privacidad', label: 'Privacidad' },
	{ href: '/terminos', label: 'Términos' },
];
---

<footer class="site-footer">
	<div class="container footer-top">
		<div class="footer-brand">
			<NidoMark variant="light" size={44} />
			<p class="footer-tagline">El nido que hace que tus clientes vuelvan.</p>
			<a href="/#lista-espera" class="btn btn-primary footer-cta" data-coming-soon>Descargar Nidus</a>
		</div>

		<div class="footer-cols">
			<div class="footer-col">
				<span class="footer-col-title">Producto</span>
				{producto.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</div>

			<div class="footer-col">
				<span class="footer-col-title">Pases</span>
				{pases.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</div>

			<div class="footer-col">
				<span class="footer-col-title">Legal</span>
				{legal.map((item) => (
					<a href={item.href}>{item.label}</a>
				))}
			</div>

			<div class="footer-col">
				<span class="footer-col-title">Contacto</span>
				<a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
				<a href="https://nidu.app">nidu.app</a>
				<a href="/#lista-espera">Lista de espera</a>
			</div>
		</div>
	</div>

	<div class="container footer-bar" aria-hidden="true"><span></span></div>

	<div class="container footer-bottom">
		<p class="footer-copy">© 2026 Nidu</p>
		<p class="footer-copy">Hecho en Ecuador</p>
		<p class="footer-copy footer-roadmap">Próximo: reseñas, WhatsApp y cobro desde el punto de venta.</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--paper);
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		padding-top: 88px;
		overflow: hidden;
	}

	.footer-top {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		text-align: center;
	}

	.footer-tagline {
		color: var(--muted);
		font-size: 16px;
		max-width: 32ch;
		margin: 0;
	}

	.footer-cta {
		margin-top: 4px;
		height: 44px;
		padding-inline: 22px;
		font-size: 14px;
	}

	.footer-cols {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px 24px;
		max-width: 720px;
		margin-inline: auto;
		text-align: center;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-col-title {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
		margin-bottom: 4px;
	}

	.footer-col a {
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
		font-weight: 500;
		transition: color var(--t-fast) var(--ease-out-cubic);
	}

	.footer-col a:hover {
		color: var(--ink);
	}

	/* The logo's bar, full width: the nest filled end to end */
	.footer-bar {
		margin-top: 64px;
		margin-bottom: 40px;
	}

	.footer-bar span {
		display: block;
		height: clamp(28px, 4.5vw, 52px);
		border-radius: 999px;
		background: var(--brand-gradient) content-box;
		border: 2px solid var(--ink);
		padding: clamp(4px, 0.7vw, 8px);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px 20px;
		padding-block: 28px 32px;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
	}

	.footer-copy {
		color: var(--faint);
		font-size: 13px;
		margin: 0;
	}

	.footer-roadmap {
		flex-basis: 100%;
		text-align: center;
	}

	@media (min-width: 900px) {
		.footer-top {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
		}

		.footer-brand {
			align-items: flex-start;
			text-align: left;
			max-width: 280px;
			flex-shrink: 0;
		}

		.footer-cols {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			text-align: left;
			margin-inline: 0;
			max-width: none;
			flex: 1;
		}

		.footer-bottom {
			justify-content: space-between;
		}

		.footer-roadmap {
			flex-basis: auto;
			text-align: right;
		}
	}
</style>
