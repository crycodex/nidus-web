---
import NidoMark from './NidoMark.astro';

const SUPPORT_EMAIL = 'soporte@nidu.app';
---

<footer class="site-footer">
	<div class="container footer-top">
		<div class="footer-brand">
			<NidoMark variant="dark" size={30} />
			<p class="footer-tagline">El nido que hace que tus clientes vuelvan.</p>
		</div>

		<div class="footer-cols">
			<div class="footer-col">
				<span class="footer-col-title">Producto</span>
				<a href="#producto">Producto</a>
				<a href="#como">Cómo funciona</a>
				<a href="#precios">Precios</a>
				<a href="#ia">IA</a>
			</div>

			<div class="footer-col">
				<span class="footer-col-title">Legal</span>
				<a href="/privacidad">Privacidad</a>
				<a href="/terminos">Términos</a>
			</div>

			<div class="footer-col">
				<span class="footer-col-title">Contacto</span>
				<a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
				<a href="https://nidu.app">nidu.app</a>
			</div>
		</div>
	</div>

	<div class="footer-wordmark" aria-hidden="true">NIDUS</div>

	<div class="container footer-bottom">
		<p class="footer-copy">© 2026 Nidu</p>
		<p class="footer-copy">Hecho en Ecuador</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--paper);
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		padding-top: 88px;
		overflow: hidden;
	}

	.footer-top {
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		text-align: center;
	}

	.footer-tagline {
		color: var(--muted);
		font-size: 16px;
		max-width: 32ch;
		margin: 0;
	}

	.footer-cols {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		max-width: 640px;
		margin-inline: auto;
		text-align: center;
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-col-title {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
		margin-bottom: 4px;
	}

	.footer-col a {
		color: var(--muted);
		text-decoration: none;
		font-size: 14px;
		font-weight: 500;
		transition: color var(--t-fast) var(--ease-out-cubic);
	}

	.footer-col a:hover {
		color: var(--ink);
	}

	.footer-wordmark {
		margin-top: 64px;
		text-align: center;
		font-family: var(--font-ui);
		font-weight: 800;
		letter-spacing: -0.04em;
		font-size: clamp(4rem, 18vw, 11rem);
		line-height: 1;
		color: var(--canvas);
		user-select: none;
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 20px;
		padding-block: 28px 32px;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
	}

	.footer-copy {
		color: var(--faint);
		font-size: 13px;
		margin: 0;
	}

	@media (min-width: 720px) {
		.footer-top {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
		}

		.footer-brand {
			align-items: flex-start;
			text-align: left;
		}

		.footer-cols {
			text-align: left;
			margin-inline: 0;
		}

		.footer-bottom {
			justify-content: space-between;
		}
	}
</style>
