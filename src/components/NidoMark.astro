---
interface Props {
	/** 'light' = ink logo for light surfaces, 'dark' = white logo for dark surfaces */
	variant?: 'dark' | 'light';
	/** Rendered height in px; width follows the logo's aspect ratio */
	size?: number;
	class?: string;
}

// Trimmed from public/brand/nidus.png by the asset export (960×467)
const RATIO = 960 / 467;

const { variant = 'dark', size = 24, class: className = '' } = Astro.props;
const width = Math.round(size * RATIO);
const base = variant === 'dark' ? '/brand/nidus-logo-light' : '/brand/nidus-logo';
---

<img
	src={`${base}-240.png`}
	srcset={`${base}-240.png 240w, ${base}.png 960w`}
	sizes={`${width}px`}
	width={width}
	height={size}
	alt=""
	aria-hidden="true"
	decoding="async"
	class:list={['nido-logo', className]}
/>

<style>
	.nido-logo {
		display: block;
		object-fit: contain;
	}
</style>
