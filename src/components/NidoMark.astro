---
interface Props {
	variant?: 'dark' | 'light';
	size?: number;
	showWordmark?: boolean;
	class?: string;
}

const { variant = 'dark', size = 32, showWordmark = true, class: className = '' } = Astro.props;
---

<span class:list={['nido-mark', className]}>
	<img
		src="/brand/nidus_bgremove.png"
		width={size}
		height={size}
		alt=""
		aria-hidden="true"
		class="nido-icon"
		data-variant={variant}
	/>
	{showWordmark && <span class="nido-wordmark" data-variant={variant}>NIDUS</span>}
</span>

<style>
	.nido-mark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.nido-icon {
		display: block;
		object-fit: contain;
	}

	.nido-icon[data-variant='light'] {
		filter: invert(1) brightness(2);
	}

	.nido-wordmark {
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 20px;
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--ink);
	}

	.nido-wordmark[data-variant='light'] {
		color: var(--paper);
	}
</style>
