---
interface Props {
	/** 'light' = ink logo for light surfaces, 'dark' = white logo for dark surfaces */
	variant?: 'dark' | 'light';
	/** Rendered height in px; width follows the logo's aspect ratio */
	size?: number;
	class?: string;
}

// Trimmed from public/brand/nidus.png by the asset export (960×467)
const RATIO = 960 / 467;

const { variant = 'dark', size = 24, class: className = '' } = Astro.props;
const width = Math.round(size * RATIO);
const src = variant === 'dark' ? '/brand/nidus-logo-light.png' : '/brand/nidus-logo.png';
---

<img src={src} width={width} height={size} alt="" aria-hidden="true" decoding="async" class:list={['nido-logo', className]} />

<style>
	.nido-logo {
		display: block;
		object-fit: contain;
	}
</style>
