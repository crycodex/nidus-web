---
import NidoMark from './NidoMark_alt.astro';

const links = [
	{ href: '#producto', label: 'Producto', section: 'producto' },
	{ href: '#como', label: 'Cómo', section: 'como' },
	{ href: '#para-quien', label: 'Para quién', section: 'para-quien' },
	{ href: '#precios', label: 'Precios', section: 'precios' },
	{ href: '#ia', label: 'IA', section: 'ia' },
];
---

<div class="notch-stage" id="notch-stage">


	<nav class="notch notch-menu" aria-label="Secciones" id="notch-menu">
		<a href="#top" class="notch-logo" aria-label="Nidus, inicio">
			<NidoMark size={18} />
		</a>
		<span class="notch-pill" id="notch-pill" aria-hidden="true"></span>
		{
			links.map((link) => (
				<a href={link.href} data-section={link.section}>
					{link.label}
				</a>
			))
		}
	</nav>

	<a href="#descargar" class="notch notch-cta btn btn-primary on-dark">Descargar</a>

	<div class="notch notch-mobile" id="notch-mobile">
		<a href="#top" class="mobile-brand" aria-label="Nidus, inicio">
			<NidoMark size={16} />
		</a>
		<button
			id="mobile-toggle"
			class="mobile-toggle"
			aria-expanded="false"
			aria-controls="mobile-dropdown"
			aria-label="Abrir menú"
		>
			<span></span>
		</button>
	</div>

	<div class="mobile-dropdown" id="mobile-dropdown">
		{
			links.map((link) => (
				<a href={link.href} data-section={link.section}>
					{link.label}
				</a>
			))
		}
		<a href="#descargar" class="btn btn-primary on-dark mobile-cta">Descargar</a>
	</div>
</div>

<script>
	import { gsap } from 'gsap';

	const menu = document.getElementById('notch-menu');
	const pill = document.getElementById('notch-pill');
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.notch-menu a[data-section]'));
	const sections = links
		.map((link) => document.getElementById(link.dataset.section ?? ''))
		.filter((el): el is HTMLElement => Boolean(el));

	function movePillTo(link: HTMLAnchorElement | undefined) {
		if (!link || !menu || !pill) return;
		const menuRect = menu.getBoundingClientRect();
		const linkRect = link.getBoundingClientRect();
		gsap.to(pill, {
			x: linkRect.left - menuRect.left,
			width: linkRect.width,
			duration: 0.45,
			ease: 'power3.out',
		});
	}

	function setActive(section: string) {
		links.forEach((link) => link.classList.toggle('is-active', link.dataset.section === section));
		movePillTo(links.find((link) => link.dataset.section === section));
	}

	if (sections.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActive(entry.target.id);
					}
				});
			},
			{ rootMargin: '-45% 0px -45% 0px', threshold: 0 }
		);
		sections.forEach((section) => observer.observe(section));
	}

	window.addEventListener('resize', () => {
		const active = links.find((link) => link.classList.contains('is-active'));
		if (active) movePillTo(active);
	});

	// Mobile dropdown
	const toggle = document.getElementById('mobile-toggle');
	const dropdown = document.getElementById('mobile-dropdown');

	toggle?.addEventListener('click', () => {
		const isOpen = dropdown?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	dropdown?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			dropdown.classList.remove('is-open');
			toggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.notch-stage {
		position: fixed;
		top: 16px;
		left: 0;
		right: 0;
		z-index: 50;
		pointer-events: none;
	}

	.notch {
		position: fixed;
		top: 16px;
		pointer-events: auto;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 999px;
		box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.5);
	}

	.notch-logo {
		left: 16px;
		display: none;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding-inline: 12px;
	}

	.notch-menu {
		display: none;
		left: 50%;
		transform: translateX(-50%);
		align-items: center;
		gap: 4px;
		height: 44px;
		padding-inline: 6px;
	}

	.notch-pill {
		position: absolute;
		top: 6px;
		left: 0;
		height: calc(100% - 12px);
		width: 0;
		border-radius: 999px;
		background: var(--purple);
		z-index: 0;
	}

	.notch-menu a {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		height: 32px;
		padding-inline: 16px;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		font-size: 13px;
		font-weight: 600;
		border-radius: 999px;
		transition: color var(--t-fast) var(--ease-out-cubic);
	}

	.notch-menu a.is-active {
		color: var(--paper);
	}

	.notch-menu a:hover:not(.is-active) {
		color: rgba(255, 255, 255, 0.92);
	}

	.notch-cta {
		right: 16px;
		display: none;
		height: 44px;
		padding-inline: 22px;
		font-size: 13px;
	}

	.notch-mobile {
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 10px;
		height: 48px;
		padding-inline: 10px 8px;
	}

	.mobile-brand {
		display: inline-flex;
	}

	.mobile-toggle {
		width: 32px;
		height: 32px;
		border-radius: 999px;
		border: none;
		background: rgba(255, 255, 255, 0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0;
	}

	.mobile-toggle span {
		display: block;
		width: 12px;
		height: 12px;
		border-right: 1.5px solid var(--paper);
		border-bottom: 1.5px solid var(--paper);
		transform: rotate(45deg) translate(-1px, -1px);
		transition: transform var(--t-fast) var(--ease-out-cubic);
	}

	.mobile-toggle[aria-expanded='true'] span {
		transform: rotate(225deg) translate(-1px, -1px);
	}

	.mobile-dropdown {
		position: fixed;
		top: 72px;
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		z-index: 49;
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: min(280px, 84vw);
		padding: 10px;
		background: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 24px;
		box-shadow: 0 20px 48px -16px rgba(0, 0, 0, 0.6);
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--t-mid) var(--ease-out-cubic), transform var(--t-mid) var(--ease-out-cubic);
	}

	.mobile-dropdown.is-open {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
		pointer-events: auto;
	}

	.mobile-dropdown a:not(.mobile-cta) {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 15px;
		font-weight: 600;
		padding: 12px 14px;
		border-radius: 14px;
	}

	.mobile-dropdown a:not(.mobile-cta):hover {
		background: rgba(255, 255, 255, 0.08);
	}

	.mobile-cta {
		margin-top: 6px;
		height: 44px;
	}

	@media (min-width: 900px) {
		.notch-logo,
		.notch-menu,
		.notch-cta {
			display: flex;
		}

		.notch-mobile,
		.mobile-dropdown {
			display: none !important;
		}
	}
</style>
