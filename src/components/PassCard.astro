---
export type PassColor =
	| 'purple'
	| 'tomate'
	| 'grafito'
	| 'azul'
	| 'verde'
	| 'fucsia'
	| 'dorado'
	| 'turquesa';

interface Props {
	size?: 'hero' | 'default' | 'compact';
	class?: string;
	color?: PassColor;
	business?: string;
	rule?: string;
	filled?: number;
	total?: number;
	interactive?: boolean;
}

const COLORS: Record<PassColor, { from: string; to: string; check: string; shadow: string }> = {
	purple: { from: '#7C3AED', to: '#4C1D95', check: '#7C3AED', shadow: 'rgba(76, 29, 149, 0.45)' },
	tomate: { from: '#FF6B4A', to: '#B93E1F', check: '#FF6B4A', shadow: 'rgba(185, 62, 31, 0.42)' },
	grafito: { from: '#4B5563', to: '#1F2937', check: '#4B5563', shadow: 'rgba(31, 41, 55, 0.5)' },
	azul: { from: '#3B82F6', to: '#1E3A8A', check: '#3B82F6', shadow: 'rgba(30, 58, 138, 0.45)' },
	verde: { from: '#22C55E', to: '#14532D', check: '#22C55E', shadow: 'rgba(20, 83, 45, 0.42)' },
	fucsia: { from: '#EC4899', to: '#831843', check: '#EC4899', shadow: 'rgba(131, 24, 67, 0.42)' },
	dorado: { from: '#E7B546', to: '#8A5A0A', check: '#E7B546', shadow: 'rgba(138, 90, 10, 0.4)' },
	turquesa: { from: '#2DD4BF', to: '#115E59', check: '#2DD4BF', shadow: 'rgba(17, 94, 89, 0.42)' },
};

const {
	size = 'default',
	class: className = '',
	color = 'purple',
	business = 'Café Aurora',
	rule = '8 sellos = café gratis',
	filled = 7,
	total = 8,
	interactive = false,
} = Astro.props;

const stamps = Array.from({ length: total });
const palette = COLORS[color];
---

<div
	class:list={['pass-card', size, className, { interactive }]}
	data-interactive={interactive}
	style={{
		'--from': palette.from,
		'--to': palette.to,
		'--pass-shadow': palette.shadow,
	}}
>
	<div class="pass-top">
		<span class="pass-eyebrow">Tarjeta de sellos</span>
		{
			interactive ? (
				<span
					class="pass-business editable"
					contenteditable="true"
					spellcheck="false"
					data-field="business"
					data-placeholder="Nombre de tu negocio"
					data-maxlength="24"
				>
					{business}
				</span>
			) : (
				<span class="pass-business">{business}</span>
			)
		}
	</div>

	<div
		class:list={['pass-stamps', { clickable: interactive }]}
		role={interactive ? 'group' : 'img'}
		aria-label={`${filled} de ${total} sellos completados`}
	>
		{
			stamps.map((_, i) => {
				const StampTag = interactive ? 'button' : 'span';
				return (
					<StampTag
						type={interactive ? 'button' : undefined}
						class:list={['stamp', { filled: i < filled }]}
						data-index={interactive ? i : undefined}
						aria-label={interactive ? `Sello ${i + 1}` : undefined}
					>
						{i < filled && (
							<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
								<path
									d="M4 12.5L9.5 18L20 6"
									fill="none"
									stroke={palette.check}
									stroke-width="2.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
					</StampTag>
				);
			})
		}
	</div>

	<div class="pass-reward">
		<span class="reward-label">Recompensa</span>
		{
			interactive ? (
				<span
					class="reward-value editable"
					contenteditable="true"
					spellcheck="false"
					data-field="rule"
					data-placeholder="Ej: 8 sellos = café gratis"
					data-maxlength="40"
				>
					{rule}
				</span>
			) : (
				<span class="reward-value">{rule}</span>
			)
		}
	</div>

	<div class="pass-footer">
		<span class="nest-glyph" aria-hidden="true">
			<svg viewBox="0 0 48 24" width="22" height="11" fill="none">
				<path
					d="M4 14C10 20 17 22 24 22C31 22 38 20 44 14"
					stroke="white"
					stroke-width="1.4"
					stroke-linecap="round"
					opacity="0.9"
				/>
				<path
					d="M8 12C13 17 18 19 24 19C30 19 35 17 40 12"
					stroke="white"
					stroke-width="1.4"
					stroke-linecap="round"
					opacity="0.7"
				/>
			</svg>
		</span>
		<span>Hecho con Nidus</span>
	</div>
</div>

<script>
	// Runs once per page: wires up every interactive pass card (contenteditable
	// name/reward fields + clickable stamps), not just the one that triggered it.
	const initInteractivePasses = () => {
		document.querySelectorAll<HTMLElement>('.pass-card.interactive').forEach((card) => {
			if (card.dataset.wired === '1') return;
			card.dataset.wired = '1';

			card.querySelectorAll<HTMLElement>('.editable').forEach((field) => {
				const maxLength = Number(field.dataset.maxlength ?? '999');

				field.addEventListener('input', () => {
					if (field.textContent && field.textContent.length > maxLength) {
						field.textContent = field.textContent.slice(0, maxLength);
						// keep the caret at the end after trimming
						const range = document.createRange();
						range.selectNodeContents(field);
						range.collapse(false);
						const selection = window.getSelection();
						selection?.removeAllRanges();
						selection?.addRange(range);
					}
				});

				field.addEventListener('paste', (event) => {
					event.preventDefault();
					const text = event.clipboardData?.getData('text/plain') ?? '';
					document.execCommand('insertText', false, text.slice(0, maxLength));
				});

				field.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') event.preventDefault();
				});
			});

			card.querySelectorAll<HTMLButtonElement>('.stamp[data-index]').forEach((stamp) => {
				stamp.addEventListener('click', () => {
					stamp.classList.toggle('filled');
				});
			});
		});
	};

	initInteractivePasses();
	document.addEventListener('astro:page-load', initInteractivePasses);
</script>

<style>
	.pass-card {
		--pass-w: 320px;
		--pass-h: 200px;
		position: relative;
		width: var(--pass-w);
		height: var(--pass-h);
		border-radius: var(--r-hero);
		padding: 24px 26px;
		background: linear-gradient(135deg, var(--from) 0%, var(--to) 100%);
		color: var(--paper);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-shadow: 0 24px 48px -12px var(--pass-shadow), var(--shadow-lifted);
		overflow: hidden;
		font-family: var(--font-ui);
	}

	.pass-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 85% -10%, rgba(255, 255, 255, 0.22), transparent 55%);
		pointer-events: none;
	}

	.pass-card.hero {
		--pass-w: 380px;
		--pass-h: 232px;
	}

	.pass-card.compact {
		--pass-w: 260px;
		--pass-h: 168px;
		padding: 20px 22px;
	}

	.pass-top {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.pass-eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.pass-business {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.pass-card.compact .pass-business {
		font-size: 18px;
	}

	.editable {
		outline: none;
		border-radius: 6px;
		padding: 1px 4px;
		margin: -1px -4px;
		cursor: text;
		transition: background var(--t-fast) var(--ease-out-cubic);
	}

	.editable:hover {
		background: rgba(255, 255, 255, 0.12);
	}

	.editable:focus {
		background: rgba(255, 255, 255, 0.18);
		box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.5);
	}

	.editable:empty::before {
		content: attr(data-placeholder);
		opacity: 0.55;
	}

	.pass-stamps {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.stamp {
		width: 26px;
		height: 26px;
		border-radius: 999px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.14);
		border: 1.5px dashed rgba(255, 255, 255, 0.4);
		padding: 0;
		font: inherit;
		color: inherit;
	}

	.pass-stamps.clickable .stamp {
		cursor: pointer;
		transition: transform var(--t-fast) var(--ease-out-cubic), background var(--t-fast) var(--ease-out-cubic);
	}

	.pass-stamps.clickable .stamp:hover {
		transform: scale(1.08);
		background: rgba(255, 255, 255, 0.26);
	}

	.pass-stamps.clickable .stamp.filled:hover {
		background: var(--paper);
	}

	.pass-card.compact .stamp {
		width: 21px;
		height: 21px;
	}

	.stamp.filled {
		background: var(--paper);
		border-style: solid;
		border-color: var(--paper);
	}

	.pass-reward {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.reward-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.reward-value {
		font-size: 15px;
		font-weight: 700;
	}

	.pass-card.compact .reward-value {
		font-size: 13px;
	}

	.pass-footer {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 600;
		opacity: 0.88;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		padding-top: 12px;
	}

	@media (max-width: 480px) {
		.pass-card,
		.pass-card.hero {
			--pass-w: min(320px, 84vw);
			--pass-h: 196px;
		}
	}
</style>
