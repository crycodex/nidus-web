---
interface Props {
	size?: 'hero' | 'default';
	class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;
const stamps = Array.from({ length: 8 });
---

<div class:list={['pass-card', size, className]}>
	<div class="pass-top">
		<span class="pass-eyebrow">Tarjeta de sellos</span>
		<span class="pass-business">Café Aurora</span>
	</div>

	<div class="pass-stamps" role="img" aria-label="7 de 8 sellos completados">
		{
			stamps.map((_, i) => (
				<span class:list={['stamp', { filled: i < 7 }]}>
					{i < 7 && (
						<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
							<path
								d="M4 12.5L9.5 18L20 6"
								fill="none"
								stroke="#7C3AED"
								stroke-width="2.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					)}
				</span>
			))
		}
	</div>

	<div class="pass-reward">
		<span class="reward-label">Recompensa</span>
		<span class="reward-value">8 sellos = café gratis</span>
	</div>

	<div class="pass-footer">
		<span class="nest-glyph" aria-hidden="true">
			<svg viewBox="0 0 48 24" width="22" height="11" fill="none">
				<path d="M4 14C10 20 17 22 24 22C31 22 38 20 44 14" stroke="white" stroke-width="1.4" stroke-linecap="round" opacity="0.9" />
				<path d="M8 12C13 17 18 19 24 19C30 19 35 17 40 12" stroke="white" stroke-width="1.4" stroke-linecap="round" opacity="0.7" />
			</svg>
		</span>
		<span>Hecho con Nidus</span>
	</div>
</div>

<style>
	.pass-card {
		--pass-w: 320px;
		--pass-h: 200px;
		position: relative;
		width: var(--pass-w);
		height: var(--pass-h);
		border-radius: var(--r-hero);
		padding: 24px 26px;
		background: linear-gradient(135deg, var(--purple) 0%, var(--purple-deep) 100%);
		color: var(--paper);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		box-shadow: 0 24px 48px -12px rgba(76, 29, 149, 0.45), var(--shadow-lifted);
		overflow: hidden;
		font-family: var(--font-ui);
	}

	.pass-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 85% -10%, rgba(255, 255, 255, 0.22), transparent 55%);
		pointer-events: none;
	}

	.pass-card.hero {
		--pass-w: 380px;
		--pass-h: 232px;
	}

	.pass-top {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.pass-eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.pass-business {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.pass-stamps {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.stamp {
		width: 26px;
		height: 26px;
		border-radius: 999px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.14);
		border: 1.5px dashed rgba(255, 255, 255, 0.4);
	}

	.stamp.filled {
		background: var(--paper);
		border-style: solid;
		border-color: var(--paper);
	}

	.pass-reward {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.reward-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.reward-value {
		font-size: 15px;
		font-weight: 700;
	}

	.pass-footer {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 600;
		opacity: 0.88;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		padding-top: 12px;
	}

	@media (max-width: 480px) {
		.pass-card,
		.pass-card.hero {
			--pass-w: min(320px, 84vw);
			--pass-h: 196px;
		}
	}
</style>
