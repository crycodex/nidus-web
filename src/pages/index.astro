---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PassCard from '../components/PassCard.astro';
import type { PassColor, PassKind } from '../components/PassCard.astro';
import BackgroundBeams from '../components/BackgroundBeams.astro';
import ShapeWaves from '../components/ShapeWaves';

const SUPPORT_EMAIL = 'soporte@nidu.app';

// TODO: reemplazar cuando la app esté publicada; el botón "Descargar" debería
// abrir ambas tiendas o detectar la plataforma del visitante.
const APP_STORE_URL = 'https://apps.apple.com/app/nidus';

const comoFunciona = [
	{
		n: '1',
		title: 'Publica tu tarjeta',
		body: 'Eliges el rubro. Nidus arma sellos y recompensa. Imprimes el QR.',
	},
	{
		n: '2',
		title: 'El cliente se une en 20 segundos',
		body: 'Escanea, pone su nombre, guarda el pase. Cero apps.',
	},
	{
		n: '3',
		title: 'Tú sellas en el mostrador',
		body: 'Abres Sellar, apuntas al pase, listo. Cuando completa, canjeas. El wallet se actualiza solo.',
	},
];

const paraNegocio = [
	{ title: 'Sellar', body: 'Cámara al QR del pase.' },
	{
		title: 'Tarjetas a tu medida',
		body: 'Sellos, puntos, visitas o consumo. Cupón, entrada, membresía, regalo.',
	},
	{
		title: 'Clientes y niveles',
		body: 'Quién es nuevo, quién está en riesgo, quién cumple años, quién es top.',
	},
	{
		title: 'Campañas en el pase',
		body: 'El mensaje llega al wallet, no a un correo que nadie abre.',
	},
	{ title: 'Equipo y sucursales', body: 'El mostrador sella. El dueño ve el ranking.' },
	{
		title: 'Métricas',
		body: 'Sellos, canjes, nuevos vs recurrentes, embudo de inscripción → primer sello → canje.',
	},
];

const rubros = [
	{ nombre: 'Café', regla: '8 sellos = café gratis' },
	{ nombre: 'Barbería', regla: '6 cortes = 1 corte gratis' },
	{ nombre: 'Restaurante', regla: '10 visitas = plato de la casa' },
	{ nombre: 'Gimnasio', regla: '10 visitas = 1 clase gratis' },
	{ nombre: 'Tienda de ropa', regla: '8 compras = 20% off' },
	{ nombre: 'Suplementos', regla: '8 compras = producto de regalo' },
	{ nombre: 'Farmacia', regla: '10 visitas = descuento' },
	{ nombre: 'Agencia', regla: '6 reservas = beneficio de cortesía' },
	{ nombre: 'Otro', regla: 'Tú defines la regla' },
];

type GalleryPass = {
	kind: PassKind;
	color: PassColor;
	business: string;
	rule: string;
	filled?: number;
	total?: number;
	highlight?: string;
	highlightLabel?: string;
	metaLabel?: string;
	metaValue?: string;
};

const galeriaPases: GalleryPass[] = [
	{
		kind: 'loyalty' as const,
		color: 'purple' as const,
		business: 'Café Aurora',
		rule: '8 sellos = café gratis',
		filled: 6,
		total: 8,
	},
	{
		kind: 'coupon' as const,
		color: 'fucsia' as const,
		business: 'Closet Nora',
		rule: '20% en tu próxima compra',
		highlight: '20%',
		highlightLabel: 'Descuento',
	},
	{
		kind: 'event' as const,
		color: 'azul' as const,
		business: 'Agencia Norte',
		rule: 'Acceso al evento',
		metaLabel: 'Fecha',
		metaValue: 'Sáb 21:00',
		highlight: 'Sala Norte',
	},
	{
		kind: 'membership' as const,
		color: 'verde' as const,
		business: 'Studio Vital',
		rule: 'Acceso de socio',
		highlight: 'Socio',
		highlightLabel: 'Nivel',
	},
	{
		kind: 'gift' as const,
		color: 'dorado' as const,
		business: 'NutriMax',
		rule: 'Saldo de regalo',
		highlight: '$20',
		highlightLabel: 'Saldo',
	},
	{
		kind: 'pass' as const,
		color: 'turquesa' as const,
		business: 'Fonda La Esquina',
		rule: 'Entrada para ti y un acompañante',
		highlight: '2',
		highlightLabel: 'Personas',
	},
	{
		kind: 'levels' as const,
		color: 'grafito' as const,
		business: 'Barbería Roble',
		rule: 'Bronce, Plata u Oro según tus visitas',
	},
	{
		kind: 'loyalty' as const,
		color: 'tomate' as const,
		business: 'Farmacia San Juan',
		rule: '10 visitas = descuento',
		filled: 4,
		total: 10,
	},
];

const planes = [
	{
		nombre: 'Mensual',
		precio: '$20',
		periodo: '/mes',
		nota: 'Cancela cuando quieras.',
		destacado: false,
	},
	{
		nombre: 'Anual',
		precio: '$200',
		periodo: '/año',
		nota: 'Ahorra 2 meses frente al mensual.',
		destacado: true,
	},
];
---

<Layout>
	<Nav />

	<main id="top">
		<!-- A: Hero -->
		<section class="hero" id="descargar">
			<div class="hero-waves" aria-hidden="true">
				<ShapeWaves
					client:only="react"
					color="#929292"
					hoverColor="#ffffff"
					backgroundColor="#000000"
					shapes="mixed"
					cellSize={10}
					dotSize={0.75}
					speed={1}
					scale={1}
					contrast={1}
					brightness={0.4}
					fade={0.25}
					interactive={true}
					splashRadius={40}
					splashStrength={0.4}
					glow={0.35}
					intro={true}
					introDuration={1.6}
					paused={false}
				>
					<div slot="fallback" class="hero-waves-fallback"></div>
				</ShapeWaves>
			</div>
			<div class="container hero-grid">
				<div class="hero-copy">
					<p class="eyebrow on-dark">Nidus</p>
					<h1>Fideliza a tus clientes sin fricción</h1>
					<p class="hero-lead">
						Tus clientes no tienen que descargar nada. La tarjeta vive en Apple Wallet y Google
						Wallet. Tú solo escaneas.
					</p>

					<div class="hero-ctas">
						<a href={APP_STORE_URL} class="btn btn-primary on-dark">Descargar la app</a>
						<a href="#como" class="btn btn-outline on-dark">Ver cómo funciona</a>
					</div>

					<p class="hero-micro">Disponible para iOS y Android. El cliente no instala Nidus.</p>
				</div>

				<div class="hero-visual">
					<div id="hero-pass-wrap" class="hero-pass-wrap">
						<PassCard size="hero" interactive />
						<p class="hero-pass-hint">Toca el nombre, la recompensa o los sellos — es tu tarjeta.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- C: Cómo funciona -->
		<section class="como" id="como">
			<div class="container">
				<h2 class="section-title">Cómo funciona</h2>
				<div class="steps" data-reveal-group>
					{
						comoFunciona.map((step) => (
							<div class="step" data-reveal>
								<span class="step-n">{step.n}</span>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- D: El nido del cliente -->
		<section class="nido-cliente" id="producto">
			<div class="container nido-cliente-grid">
				<div class="nido-cliente-copy" data-reveal>
					<h2>El nido está en su wallet, no en otra app.</h2>
					<p>
						Cada sello, cada promoción y cada felicitación de cumpleaños aparecen en Apple Wallet
						o Google Wallet. El cliente ya abre esa app. Nidus no le pide otra.
					</p>
					<ul class="check-list">
						<li>Únete gratis, sin descargar nada</li>
						<li>Cero contraseñas, cero cuentas</li>
						<li>El pase se actualiza después de cada sello</li>
					</ul>
				</div>
				<div class="nido-cliente-visual" data-reveal>
					<PassCard />
				</div>
			</div>
		</section>

		<!-- E: Para el negocio -->
		<section class="para-negocio" id="para-quien">
			<div class="container">
				<h2 class="section-title">Para el negocio</h2>
				<div class="feature-grid" data-reveal-group>
					{
						paraNegocio.map((f) => (
							<div class="feature-card" data-reveal>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- F: Rubros -->
		<section class="rubros">
			<div class="container">
				<h2 class="section-title">Hecho para el local, no para la cadena.</h2>
				<div class="rubro-chips" data-reveal-group>
					{
						rubros.map((r) => (
							<div class="rubro-chip" data-reveal>
								<span class="rubro-nombre">{r.nombre}</span>
								<span class="rubro-regla">{r.regla}</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Galería de pases -->
		<section class="galeria" id="pases">
			<div class="container galeria-header" data-reveal>
				<h2 class="section-title">Un pase para cada negocio.</h2>
				<p class="galeria-lead">
					Fidelización, cupón, entrada, membresía, tarjeta de regalo o un pase. También niveles
					Bronce, Plata y Oro.
				</p>
			</div>
			<div class="galeria-viewport">
				<div class="galeria-track">
					{
						[...galeriaPases, ...galeriaPases].map((p, i) => (
							<div class="galeria-item" aria-hidden={i >= galeriaPases.length}>
								<PassCard
									size="compact"
									kind={p.kind}
									color={p.color}
									business={p.business}
									rule={p.rule}
									filled={p.filled}
									total={p.total}
									highlight={p.highlight}
									highlightLabel={p.highlightLabel}
									metaLabel={p.metaLabel}
									metaValue={p.metaValue}
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Precios -->
		<section class="precios" id="precios">
			<div class="container">
				<h2 class="section-title">Un precio, sin letra chica.</h2>
				<div class="planes" data-reveal-group>
					{
						planes.map((plan) => (
							<div class:list={['plan-card', { destacado: plan.destacado }]} data-reveal>
								{plan.destacado && <span class="plan-badge">Recomendado</span>}
								<span class="plan-nombre">{plan.nombre}</span>
								<div class="plan-precio">
									<span class="plan-monto">{plan.precio}</span>
									<span class="plan-periodo">{plan.periodo}</span>
								</div>
								<p class="plan-nota">{plan.nota}</p>
								<a href={APP_STORE_URL} class:list={['btn', plan.destacado ? 'btn-primary' : 'btn-outline']}>
									Empezar
								</a>
							</div>
						))
					}
				</div>

				<div class="founders-card" data-reveal>
					<span class="founders-badge">Por tiempo limitado</span>
					<h3>Sé de los fundadores de Nidus</h3>
					<p>
						Los primeros negocios que se unen ahora se quedan con beneficios que no vuelven a
						repetirse:
					</p>
					<ul class="founders-list">
						<li>Badge de fundador en la app</li>
						<li>Soporte prioritario</li>
						<li>Un mes gratis</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- G: IA -->
		<section class="ia" id="ia">
			<div class="container ia-grid">
				<div class="ia-copy" data-reveal>
					<h2>Sugerencias, no piloto automático.</h2>
					<p>
						Cuando hay historial de verdad, Nidus lee tus clientes y te arma <strong>borradores</strong>
						de campaña (quién, qué decir, por qué). Tú revisas. Si te sirve, se prellena el envío.
						<strong> Nidus no manda nada sola.</strong>
					</p>
				</div>

				<div class="ia-examples" data-reveal>
					<p class="ia-examples-label">Ejemplo ilustrativo</p>
					<div class="ia-card">
						<span class="ia-segment">Segmento: En riesgo</span>
						<p>
							«Hace 3 semanas que no te vemos. Este café te espera — el próximo sello va por
							nuestra cuenta.»
						</p>
					</div>
					<div class="ia-card">
						<span class="ia-segment">Segmento: Cumpleaños</span>
						<p>«Feliz cumpleaños. Hoy tu recompensa está a un sello.»</p>
					</div>
				</div>
			</div>
		</section>

		<!-- H: Carta del fundador -->
		<section class="carta">
			<div class="container">
				<div class="carta-card" data-reveal>
					<p>
						Nidus nació en noches en las que lo único despierto era el código y yo. No hubo plan
						de negocio detrás, hubo una idea que no me dejaba dormir:
						ningún emprendedor debería perder al cliente que ya se ganó.
					</p>
					<br />
					<p>
						Amo crear apps pero tambien quiero ayudar a que los negocios crezcan.
						 Nidus es donde se juntan las dos cosas: un nido armado línea por línea,
						para que tus clientes siempre encuentren el camino de vuelta.
					</p>
					<br />
					<a class="carta-firma-link" href="https://www.linkedin.com/in/cristhian-recalde/" target="_blank" class="carta-link">
						<p class="carta-firma"> Cristhian Recalde, fundador</p>
					</a>
				</div>
			</div>
		</section>

		<!-- I: CTA final -->
	<!-- 	<section class="cta-final">
			<div class="container cta-final-inner" data-reveal>
				<h2>Pon el nido en el mostrador esta semana.</h2>
				<a href={APP_STORE_URL} class="btn btn-primary on-dark cta-final-btn">Descargar Nidus</a>
				<p class="cta-final-note">El cliente sigue sin instalar nada.</p>
			</div>
		</section> -->

		<!-- Lista de espera -->
		<section class="waitlist" id="lista-espera">
			<BackgroundBeams />
			<div class="container waitlist-inner" data-reveal>
				<h2>Sé de los primeros en usar Nidus.</h2>
				<p class="waitlist-lead">
					Estamos afinando el lanzamiento en Apple Wallet y Google Wallet. Dejanos tu correo y te
					avisamos apenas esté lista con tu lugar reservado en la oferta de fundadores.
				</p>

				<form class="waitlist-form" id="waitlist-form" data-support-email={SUPPORT_EMAIL}>
					<input
						type="email"
						name="email"
						required
						placeholder="tu@negocio.com"
						aria-label="Tu correo"
						class="waitlist-input"
					/>
					<button type="submit" class="btn btn-primary on-dark waitlist-submit">
						Avisarme cuando esté lista
					</button>
				</form>
				<p class="waitlist-success" id="waitlist-success" hidden>
					Listo. Te avisamos apenas esté lista para descargar.
				</p>

				<p class="waitlist-note">Sin spam. Un solo correo, cuando lancemos.</p>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	import { gsap } from 'gsap';

	const wrap = document.getElementById('hero-pass-wrap');
	const card = wrap?.querySelector<HTMLElement>('.pass-card');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (wrap && card && !prefersReducedMotion) {
		gsap.to(card, {
			y: -10,
			duration: 2.6,
			ease: 'sine.inOut',
			repeat: -1,
			yoyo: true,
		});

		let isEditing = false;
		card.querySelectorAll('.editable').forEach((field) => {
			field.addEventListener('focus', () => {
				isEditing = true;
				gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.4, ease: 'power2.out' });
			});
			field.addEventListener('blur', () => {
				isEditing = false;
			});
		});

		const maxTilt = 10;
		wrap.addEventListener('pointermove', (event) => {
			if (isEditing) return;
			const rect = wrap.getBoundingClientRect();
			const px = (event.clientX - rect.left) / rect.width - 0.5;
			const py = (event.clientY - rect.top) / rect.height - 0.5;

			gsap.to(card, {
				rotateY: px * maxTilt,
				rotateX: -py * maxTilt,
				duration: 0.5,
				ease: 'power2.out',
				overwrite: 'auto',
			});
		});

		wrap.addEventListener('pointerleave', () => {
			if (isEditing) return;
			gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: 'power2.out' });
		});
	}

	// Front-end only: no waitlist backend wired up yet. Swap this for a real
	// endpoint (serverless function, Formspree, ESP form action, etc.) before launch.
	const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement | null;
	const waitlistSuccess = document.getElementById('waitlist-success');

	waitlistForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		waitlistForm.hidden = true;
		if (waitlistSuccess) waitlistSuccess.hidden = false;
	});
</script>

<style>
	.hero {
		position: relative;
		background: var(--near-black);
		color: var(--paper);
		padding-block: 120px 96px;
		overflow: hidden;
	}

	.hero-waves {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.hero-waves :global(astro-island) {
		display: block !important;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-waves-fallback {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: var(--near-black);
	}

	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: 56px;
		align-items: center;
		justify-items: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-copy h1 {
		font-size: clamp(2.75rem, 6.4vw, 5.5rem);
		margin-top: 14px;
		max-width: 14ch;
		margin-inline: auto;
		letter-spacing: -0.03em;
		background: linear-gradient(180deg, #ffffff 0%, #a1a1a6 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-lead {
		margin-top: 24px;
		font-size: 19px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.78);
		max-width: 46ch;
		margin-inline: auto;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		margin-top: 36px;
	}

	.hero-micro {
		margin-top: 18px;
		font-size: 13px;
		color: rgba(255, 255, 255, 0.5);
	}

	.hero-visual {
		display: flex;
		justify-content: center;
	}

	.hero-pass-wrap {
		perspective: 900px;
		position: relative;
	}

	.hero-pass-wrap::before {
		content: '';
		position: absolute;
		inset: -18%;
		background: radial-gradient(circle, #c9b6f2 0%, #b8c8f5 45%, #f6e7a8 75%, transparent 78%);
		filter: blur(48px);
		opacity: 0.35;
		z-index: -1;
	}

	.hero-pass-wrap :global(.pass-card) {
		transform-style: preserve-3d;
		will-change: transform;
	}

	.hero-pass-hint {
		margin: 14px 0 0;
		text-align: center;
		font-size: 12.5px;
		color: rgba(255, 255, 255, 0.45);
	}

	.section-title {
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
		margin-bottom: 48px;
		max-width: 18ch;
		margin-inline: auto;
		text-align: center;
	}

	.como {
		background: var(--canvas);
		padding-block: 96px;
	}

	.steps {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
		text-align: center;
	}

	.step {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.step-n {
		font-family: var(--font-display);
		font-size: 3rem;
		font-weight: 600;
		color: var(--purple);
		display: block;
		line-height: 1;
	}

	.step h3 {
		font-family: var(--font-ui);
		font-size: 20px;
		font-weight: 800;
		margin-top: 16px;
	}

	.step p {
		margin-top: 10px;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.6;
		max-width: 42ch;
		margin-inline: auto;
	}

	.nido-cliente {
		background: var(--paper);
		padding-block: 96px;
	}

	.nido-cliente-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 48px;
		align-items: center;
		justify-items: center;
	}

	.nido-cliente-copy {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.nido-cliente-copy h2 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		max-width: 16ch;
	}

	.nido-cliente-copy p {
		margin-top: 20px;
		font-size: 17px;
		line-height: 1.6;
		color: var(--muted);
		max-width: 48ch;
	}

	.check-list {
		list-style: none;
		padding: 0;
		margin: 28px 0 0;
		display: flex;
		flex-direction: column;
		align-items: center;
