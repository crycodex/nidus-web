---
import '../styles/global.css';
import PageLoader from '../components/PageLoader.astro';
import ComingSoonDialog from '../components/ComingSoonDialog.astro';
import {
	SITE_URL,
	SITE_NAME,
	SITE_TITLE,
	SITE_DESCRIPTION,
	OG_IMAGE,
	OG_IMAGE_ALT,
	LOCALE,
	baseJsonLd,
} from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	extraJsonLd?: Record<string, unknown>[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	ogImage = OG_IMAGE,
	extraJsonLd = [],
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = pathname === '/' ? `${SITE_URL}/` : `${SITE_URL}${pathname}`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [...baseJsonLd, ...extraJsonLd],
};
---

<!doctype html>
<html lang="es" class="is-loading">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="Nidus para modelos de lenguaje" />
		<link rel="manifest" href="/manifest.webmanifest" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content={SITE_NAME} />
		<meta name="theme-color" content="#111111" />
		<meta name="color-scheme" content="light" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="geo.region" content="EC" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={LOCALE} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={OG_IMAGE_ALT} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

		<link rel="icon" type="image/png" href="/brand/nidus_bgremove.png" />
		<link rel="apple-touch-icon" href="/brand/nidus_bgremove.png" />
		<meta name="generator" content={Astro.generator} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#top">Saltar al contenido</a>
		<PageLoader />
		<slot />
		<ComingSoonDialog />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

			if (prefersReducedMotion) {
				gsap.set(revealEls, { opacity: 1, y: 0 });
			} else {
				revealEls.forEach((el) => {
					const group = el.closest('[data-reveal-group]');
					const siblings = group
						? Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]'))
						: [el];
					const index = siblings.indexOf(el);

					gsap.fromTo(
						el,
						{ opacity: 0, y: 22 },
						{
							opacity: 1,
							y: 0,
							duration: 0.7,
							delay: index * 0.08,
							ease: 'back.out(1.5)',
							scrollTrigger: {
								trigger: el,
								start: 'top 88%',
								once: true,
							},
						}
					);
				});
			}

			const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));

			if (prefersReducedMotion) {
				gsap.set(sections, { opacity: 1, scale: 1 });
			} else {
				sections.forEach((section, i) => {
					if (i === 0) return;

					gsap.fromTo(
						section,
						{ opacity: 0, scale: 0.96 },
						{
							opacity: 1,
							scale: 1,
							duration: 0.9,
							ease: 'power3.out',
							scrollTrigger: {
								trigger: section,
								start: 'top 78%',
								once: true,
							},
						}
					);
				});
			}
		</script>
	</body>
</html>
